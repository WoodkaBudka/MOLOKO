<Window x:Class="ГЗЗЗ.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ГЗЗЗ"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtWelcome" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

        <StackPanel x:Name="AdminPanel" Grid.Row="0" Orientation="Horizontal" Margin="0,30,0,10">
            <Button Content="Добавить" Width="100" Margin="0,0,10,0" Click="BtnAdd_Click"/>
            <Button Content="Изменить" Width="100" Margin="0,0,10,0" Click="BtnEdit_Click"/>
            <Button Content="Разблокировать" Width="120" Click="BtnUnblock_Click"/>
        </StackPanel>

        <DataGrid x:Name="GridUsers" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="*"/>
                <DataGridTextColumn Header="Роль" Binding="{Binding Role}" Width="150"/>
                <DataGridCheckBoxColumn Header="Заблокирован" Binding="{Binding IsBlocked}" Width="100"/>
                <DataGridTextColumn Header="Попытки" Binding="{Binding FailedAttempts}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="2" Content="Выйти" Width="100" HorizontalAlignment="Right" Margin="0,10,0,0" Click="BtnLogout_Click"/>
    </Grid>
</Window>