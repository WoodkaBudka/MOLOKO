<Window x:Class="ГЗЗЗ.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ГЗЗЗ"
        mc:Ignorable="d"
        Title="LoginWindow" Height="450" Width="800">
    <StackPanel Margin="20">
        <TextBlock Text="Логин" Margin="0,10,0,5"/>
        <TextBox x:Name="TxtLogin" Height="25"/>

        <TextBlock Text="Пароль" Margin="0,10,0,5"/>
        <PasswordBox x:Name="TxtPass" Height="25"/>

        <TextBlock Text="Соберите пазл:" Margin="0,20,0,5"/>
        <UniformGrid x:Name="PuzzleGrid" Rows="2" Columns="2" Width="300" Height="300"/>

        <Button Content="Войти" Height="35" Margin="0,20,0,0" Click="BtnLogin_Click"/>
        <Button Content="Перемешать" Height="25" Margin="0,5,0,0" Click="BtnShuffle_Click"/>
    </StackPanel>
</Window>